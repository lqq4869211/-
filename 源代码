    <title>电脑基本使用方法 · 新手入门</title>
    <style>
        :root{
          --bg:#f6f7fb; --card:#ffffff; --ink:#2c2c35; --muted:#8a8a96;
          --accent:#2563eb; --accent-soft:#e0ecff; --line:#e3e5ec;
          --warn:#d97706; --warn-soft:#fef3c7;
          --ok:#059669; --ok-soft:#d1fae5;
          --danger:#dc2626; --danger-soft:#fee2e2;
          --code:#f1f3f8;
        }
        *{box-sizing:border-box}
        body{
          margin:0; background:var(--bg); color:var(--ink);
          font-family:"Noto Sans CJK SC","Microsoft YaHei","PingFang SC",system-ui,sans-serif;
          line-height:1.8; font-size:16px;
        }
        .wrap{max-width:860px; margin:0 auto; padding:28px 22px 80px;}
        header{
          background:linear-gradient(135deg,#2563eb,#4f46e5); color:#fff;
          padding:36px 30px; border-radius:14px; margin-bottom:28px;
          box-shadow:0 8px 24px rgba(37,99,235,.25);
        }
        header h1{margin:0 0 6px; font-size:28px; letter-spacing:1px;}
        header .sub{opacity:.85; font-size:14px;}
        .part{
          font-size:20px; font-weight:700; margin:36px 0 14px;
          padding:10px 16px; background:var(--accent-soft);
          color:#1e40af; border-radius:8px;
        }
        h2{font-size:20px; margin:28px 0 10px; padding-left:12px;
           border-left:5px solid var(--accent);}
        h3{font-size:17px; margin:22px 0 8px; color:#334155;}
        h4{font-size:15px; margin:16px 0 6px; color:#475569;}
        p{margin:8px 0;}
        ul,ol{margin:8px 0; padding-left:24px;}
        li{margin:4px 0;}
        img{max-width:100%; height:auto; display:block; margin:10px 0;
            border:1px solid var(--line); border-radius:8px; background:#fff;
            box-shadow:0 2px 8px rgba(0,0,0,.06);}
        .seg-cap{font-size:12px; color:var(--muted); margin:-2px 0 8px;}
        blockquote{
          margin:14px 0; padding:10px 16px; border-left:4px solid var(--accent);
          background:#eff4ff; border-radius:6px; color:#1e3a8a;
        }
        .tip{background:var(--ok-soft); border-left-color:var(--ok); color:#065f46;}
        .warn{background:var(--warn-soft); border-left-color:var(--warn); color:#78350f;}
        .danger{background:var(--danger-soft); border-left-color:var(--danger); color:#991b1b;}
        table{width:100%; border-collapse:collapse; margin:14px 0; font-size:14.5px;
               background:var(--card); border-radius:8px; overflow:hidden;}
        th,td{border:1px solid var(--line); padding:9px 12px; text-align:left; vertical-align:top;}
        th{background:var(--code); font-weight:600; color:#334155;}
        code{background:var(--code); padding:2px 6px; border-radius:4px;
             font-size:14px; font-family:Consolas,"Courier New",monospace;}
        kbd{
          display:inline-block; padding:1px 7px; font-size:13px;
          background:#fff; border:1px solid var(--line); border-bottom-width:2px;
          border-radius:4px; font-family:Consolas,monospace; color:#475569;
          line-height:1.4;
        }
        .step{font-weight:700; color:var(--accent);}
        .cards{display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px; margin:12px 0;}
        .card{background:var(--card); border:1px solid var(--line); border-radius:8px;
              padding:12px 14px; font-size:14.5px;}
        .card b{color:var(--accent);}
        footer{margin-top:48px; padding-top:16px; border-top:1px solid var(--line);
               color:var(--muted); font-size:13px; text-align:center;}

        /* ===== 大纲侧边栏 ===== */
        h2,h3,h4,.part{scroll-margin-top:16px;}
        #outline-toggle{
          position:fixed;top:14px;left:14px;z-index:60;width:42px;height:42px;
          border-radius:9px;border:1px solid var(--line);background:#fff;
          font-size:20px;cursor:pointer;display:none;
          box-shadow:0 1px 5px rgba(0,0,0,.12);line-height:1;color:#334155;
        }
        #overlay{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:40;display:none;}
        #overlay.show{display:block;}
        #outline{
          position:fixed;top:0;left:0;width:270px;height:100vh;overflow-y:auto;
          background:#fff;border-right:1px solid var(--line);padding:18px 10px 60px;
          transform:translateX(-100%);transition:transform .25s ease;z-index:50;
          box-sizing:border-box;
        }
        #outline.open{transform:translateX(0);box-shadow:0 0 26px rgba(0,0,0,.14);}
        #outline .otitle{font-weight:700;font-size:13px;color:var(--muted);
          padding:4px 10px 10px;letter-spacing:2px;border-bottom:1px solid var(--line);margin-bottom:8px;}
        #outline a{display:block;padding:6px 10px;font-size:14px;color:#555;
          text-decoration:none;border-radius:6px;line-height:1.45;cursor:pointer;
          border-left:3px solid transparent;margin-bottom:1px;}
        #outline a.lv0{font-weight:700;color:#1e40af;margin-top:12px;background:var(--accent-soft);}
        #outline a.lv0:first-child{margin-top:0;}
        #outline a.lv1{padding-left:22px;}
        #outline a.lv2{padding-left:38px;font-size:13.5px;color:#64748b;}
        #outline a.lv3{padding-left:54px;font-size:12.5px;color:#94a3b8;}
        #outline a.active{color:var(--accent);border-left-color:var(--accent);
          background:#eef4ff;font-weight:600;}
        @media(min-width:1060px){
          #outline{transform:none;}
          .wrap{margin-left:270px;max-width:820px;}
        }
        @media(max-width:1059px){
          #outline-toggle{display:block;}
          .wrap{padding-top:64px;}
        }
    </style>
